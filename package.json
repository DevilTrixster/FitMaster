{
  "name": "fitmaster",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:create": "node-pg-migrate create --migrations-dir src/infrastructure/database/migrations --migration-file-language ts",
    "migrate:up": "node-pg-migrate up --database-url-var DATABASE_URL --env-path .env --migrations-dir src/infrastructure/database/migrations --migration-file-language ts --tsconfig tsconfig.json --exec tsx",
    "migrate:down": "node-pg-migrate down --database-url-var DATABASE_URL --env-path .env --migrations-dir src/infrastructure/database/migrations --migration-file-language ts --tsconfig tsconfig.json --exec tsx",
    "migrate:reset": "npm run migrate:reset:db && npm run migrate:up",
    "migrate:reset:db": "tsx src/infrastructure/database/scripts/reset-db.ts"
  },
  "keywords": [],
  "author": "Spiridonov",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.14",
    "pg": "^8.21.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  }
}
